#!/bin/sh
set -u
TEMP_FILE=`mktemp -t bake.XXXXXXXXXX` || exit 1
CHILD_PID=0
function exitChild() {
  if [ $CHILD_PID = 0 ]
  then
    EXIT_CODE=1
  else
    wait $CHILD_PID
    EXIT_CODE=$?
  fi
  rm -f $TEMP_FILE
  exit $EXIT_CODE
}
trap 'kill 0; exitChild' INT TERM
